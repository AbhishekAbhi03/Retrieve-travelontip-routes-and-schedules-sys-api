#%RAML 1.0 DataType
type: array
items:
  type: object
  properties:
    availableSeats:
      type: integer
      required: true
      example: 20
    departureDateTime:
      type: datetime
      required: true
      example: 2019-04-30T16:41:41.090Z
    travelRoute:
      type: object
      properties:
        destinationLocation:
          type: object
          properties:
            locationCode:
              type: string
              required: true
              example: KLG-MY
        originLocation:
          type: object
          properties:
            locationCode:
              type: string
              required: true
              example: BEN-SG